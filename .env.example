# baseline = no model downloads; local = real local model inference
RIDSCA_MODE=local
RIDSCA_THREADS=2
RIDSCA_LLM_REPO=Qwen/Qwen3-4B-GGUF
RIDSCA_LLM_FILE=Qwen3-4B-Q4_K_M.gguf
RIDSCA_LLM_REVISION=main
RIDSCA_EMBED_MODEL=intfloat/multilingual-e5-small
RIDSCA_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RIDSCA_GUARD_MODEL=protectai/deberta-v3-base-prompt-injection-v2
RIDSCA_IMAGE_MODEL=dima806/ai_vs_real_image_detection
RIDSCA_AUDIO_MODEL=mo-thecreator/Deepfake-audio-detection
RIDSCA_WHISPER_MODEL=small
# Optional local indexes. No third-party submission of user content.
RIDSCA_URL_INDEX=local_data/url_reputation.csv
RIDSCA_APK_INDEX=local_data/apk_metadata.sqlite
RIDSCA_SESSION_TTL=1800
# Optional for Hub download rate limits. Never needed for a paid inference API.
# HF_TOKEN=
